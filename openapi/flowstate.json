                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StatusResponse": {
        "required": [
          "service",
          "version"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service name, always `flowstate`."
          },
          "version": {
            "type": "string",
            "description": "API build version."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Status"
    }
  ]
}