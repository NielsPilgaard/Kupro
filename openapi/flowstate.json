          "required": true
        },
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiTokenKind": {
        "enum": [
          "personal",
          "agent"
        ]
      },
      "ApiTokenResponse": {
        "required": [
          "id",
          "name",
          "kind",
          "agentName",
          "hint",
          "workspaceId",
          "createdAt",
          "expiresAt",
          "lastUsedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Token id, used to revoke it.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Label given at creation."
          },
          "kind": {
            "description": "Personal or agent.",
            "$ref": "#/components/schemas/ApiTokenKind"
          },
          "agentName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Agent name for agent tokens."
          },
          "hint": {
            "type": "string",
            "description": "Prefix and last four characters of the secret."
          },
          "workspaceId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Workspace the token is limited to, if any.",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "description": "Creation time.",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Expiry time, or null if it never expires.",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Last successful use (updated at most once a minute).",
            "format": "date-time"
          }
        }
      },
      "CreateApiTokenRequest": {
        "required": [
          "name",
          "kind"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Label to recognise the token, e.g. \"CI deploy\" or \"laptop CLI\"."
          },
          "kind": {
            "description": "`personal` acts as you; `agent` acts on your behalf under the agent's name.",
            "$ref": "#/components/schemas/ApiTokenKind"
          },
          "agentName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required for agent tokens: lowercase name shown in the activity log, e.g. `triage-agent`."
          },
          "expiresInDays": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Days until expiry (1-365); omit for a token that does not expire.",
            "format": "int32"
          },
          "workspace": {
            "type": [
              "null",
              "string"
            ],
            "description": "Workspace slug to limit the token to. Required for agent tokens."
          }
        }
      },
      "CreatedApiTokenResponse": {
        "required": [
          "token",
          "secret"
        ],
        "type": "object",
        "properties": {
          "token": {
            "description": "The stored token.",
            "$ref": "#/components/schemas/ApiTokenResponse"
          },
          "secret": {
            "type": "string",
            "description": "The token secret. Shown once; only its hash is stored."
          }
        }
      },
      "CreateProjectRequest": {
        "required": [
          "key",
          "name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Issue key prefix: 2-10 uppercase letters/digits starting with a letter, e.g. `FLOW`."
          },
          "name": {
            "type": "string",
            "description": "Project name."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional Markdown description."
          },
          "color": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Colour in lists and the delivery plan; picked automatically when omitted.",
                "$ref": "#/components/schemas/ProjectColor"
              }
            ]
          }
        }
      },
      "CreateWorkspaceRequest": {
        "required": [
          "name",
          "slug"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name, e.g. \"Acme\"."
          },
          "slug": {
            "type": "string",
            "description": "URL id: lowercase letters, digits and dashes, e.g. `acme`. Immutable."
          }
        }
      },
      "InviteMemberRequest": {
        "required": [
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Who to invite."
          },
          "role": {
            "description": "Role they get on accepting.",
            "$ref": "#/components/schemas/WorkspaceRole"
          }
        }
      },
      "InviteResponse": {
        "required": [
          "memberId",
          "workspaceSlug",
          "workspaceName",
          "role",
          "invitedAt"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "Id to accept the invite with.",
            "format": "uuid"
          },
          "workspaceSlug": {
            "type": "string",
            "description": "Workspace URL id."
          },
          "workspaceName": {
            "type": "string",
            "description": "Workspace name."
          },
          "role": {
            "description": "Role you get on accepting.",
            "$ref": "#/components/schemas/WorkspaceRole"
          },
          "invitedAt": {
            "type": "string",
            "description": "When the invite was sent.",
            "format": "date-time"
          }
        }
      },
      "MemberKind": {
        "enum": [
          "human",
          "agent"
        ]
