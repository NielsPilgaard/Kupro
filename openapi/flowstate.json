              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Create a project.",
        "operationId": "createProject",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
