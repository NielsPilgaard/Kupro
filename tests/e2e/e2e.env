# Variables for the E2E stack (compose.yaml). Throwaway values: the stack only lives on the runner.
# Shell variables win over this file, so e2e.yml points API_IMAGE/MIGRATIONS_IMAGE at published images on main.
API_IMAGE=flowstate-api:e2e
MIGRATIONS_IMAGE=flowstate-api:e2e
WEB_IMAGE=flowstate-web:e2e
# The public site is not started in E2E; set so Compose can validate the file.
SITE_IMAGE=flowstate-site:e2e
KEYCLOAK_IMAGE=flowstate-keycloak:e2e
POSTGRES_IMAGE=flowstate-postgres:e2e
API_PORT=8080
POSTGRES_PASSWORD=e2e-postgres
KEYCLOAK_PASSWORD=e2e-admin
KEYCLOAK_DB_PASSWORD=e2e-keycloak-db
KEYCLOAK_PUBLIC_URL=http://localhost:8180
API_PUBLIC_URL=http://localhost:5180
# No mail is sent in E2E.
SMTP_USER=
SMTP_PASSWORD=
KEYCLOAK_SMTP_FROM=no-reply@flowstate.local
# Empty key: the meeting agent uses its keyword extractor and the mic stays hidden.
SCALEWAY_AI_KEY=
# Empty STORAGE_URL disables attachments.
STORAGE_URL=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# The backup agent and Grafana are not started; set so Compose doesn't warn.
BACKUP_AGENT_IMAGE=flowstate-backup-agent:e2e
BACKUP_CONSOLE_SSH=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
BACKUP_CIPHER_PASS=
BACKUP_OPS_URL=
BACKUP_OPS_BUCKET=
BACKUP_OPS_ACCESS_KEY=
BACKUP_OPS_SECRET_KEY=
ELMAHIO_API_KEY=
ELMAHIO_LOG_ID=
ELMAHIO_HEARTBEAT_WAL=
ELMAHIO_HEARTBEAT_BACKUP=
ELMAHIO_HEARTBEAT_VERIFY=
ELMAHIO_HEARTBEAT_DRILL=
GRAFANA_PUBLIC_URL=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SMTP_FROM=
ALERT_EMAIL=
