# Variables for the E2E stack (compose.yaml). Throwaway values: the stack only lives on the runner.
# Shell variables win over this file, so e2e.yml points API_IMAGE/MIGRATIONS_IMAGE at published images on main.
API_IMAGE=flowstate-api:e2e
MIGRATIONS_IMAGE=flowstate-api:e2e
WEB_IMAGE=flowstate-web:e2e
API_PORT=8080
POSTGRES_PASSWORD=e2e-postgres
KEYCLOAK_PASSWORD=e2e-admin
KEYCLOAK_PUBLIC_URL=http://localhost:8180
API_PUBLIC_URL=http://localhost:5180
# Empty STORAGE_URL disables attachments.
STORAGE_URL=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Grafana is not started; set so Compose doesn't warn.
GRAFANA_PUBLIC_URL=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=
ALERT_EMAIL=
