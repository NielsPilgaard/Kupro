---
// SVG sprite shared by every page; colours come from tokens through currentColor and var().
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="mark" viewBox="0 0 32 32">
    <rect x="3" y="6.5" width="17" height="5" rx="2.5" fill="currentColor"></rect>
    <rect x="9" y="13.5" width="20" height="5" rx="2.5" fill="var(--acc)"></rect>
    <rect x="5" y="20.5" width="12" height="5" rx="2.5" fill="currentColor" opacity=".5"></rect>
  </symbol>
  <symbol id="i-check" viewBox="0 0 16 16">
    <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </symbol>
  <symbol id="i-shield" viewBox="0 0 16 16">
    <path d="M8 1.8l5 2v4c0 3-2.2 5.3-5 6.4C5.2 13.1 3 10.8 3 7.8v-4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
  </symbol>
  <symbol id="r-prog" viewBox="0 0 14 14">
    <circle cx="7" cy="7" r="5.5" fill="none" stroke="var(--prog)" stroke-width="1.6"></circle>
    <path d="M7 1.5a5.5 5.5 0 0 1 0 11z" fill="var(--prog)"></path>
  </symbol>
  <symbol id="r-rev" viewBox="0 0 14 14">
    <circle cx="7" cy="7" r="5.5" fill="none" stroke="var(--rev)" stroke-width="1.6"></circle>
    <path d="M7 1.5a5.5 5.5 0 1 1-5.5 5.5H7z" fill="var(--rev)"></path>
  </symbol>
</svg>
