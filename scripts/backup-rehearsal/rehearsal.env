# Variables for the backup rehearsal stack (compose.yaml next to this file). Throwaway values: the stack lives on a
# developer machine and is removed at the end of each run. Shell variables win over this file, so the script swaps
# BACKUP_S3_KEY_SECRET and BACKUP_CIPHER_PASS for the broken-key and wrong-pass cases.
API_IMAGE=kupro-api:rehearsal
MIGRATIONS_IMAGE=kupro-api:rehearsal
WEB_IMAGE=kupro-web:rehearsal
# The public site is not started; set so Compose can validate the file.
SITE_IMAGE=kupro-site:rehearsal
KEYCLOAK_IMAGE=kupro-keycloak:rehearsal
POSTGRES_IMAGE=kupro-postgres:rehearsal
BACKUP_AGENT_IMAGE=kupro-backup-agent:rehearsal
API_PORT=8080
POSTGRES_PASSWORD=rehearsal-postgres
KEYCLOAK_PASSWORD=rehearsal-admin
KEYCLOAK_DB_PASSWORD=rehearsal-keycloak-db
KEYCLOAK_PUBLIC_URL=http://localhost:8280
API_PUBLIC_URL=http://localhost:5280
SILO_PASSWORD=rehearsal-silo
# No mail is sent.
SMTP_USER=
SMTP_PASSWORD=
KEYCLOAK_SMTP_FROM=no-reply@kupro.local
SCALEWAY_AI_KEY=
STORAGE_URL=http://host.docker.internal:8290
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kupro
STORAGE_ACCESS_KEY=kupro
STORAGE_SECRET_KEY=rehearsal-silo
MEMBERS_GUESTS_PER_SEAT=
# The backup agent, with Silo for both buckets. 9290: next to the dev stack's 9190, clear of other projects' 9090.
BACKUP_CONSOLE_PORT=9290
BACKUP_CONSOLE_SSH=
BACKUP_S3_ENDPOINT=http://silo
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=pgbackrest
BACKUP_S3_KEY=kupro
BACKUP_S3_KEY_SECRET=rehearsal-silo
BACKUP_CIPHER_PASS=rehearsal-cipher-pass
BACKUP_OPS_URL=http://silo:9000
BACKUP_OPS_BUCKET=kupro-ops
BACKUP_OPS_ACCESS_KEY=kupro
BACKUP_OPS_SECRET_KEY=rehearsal-silo
# The ping receiver (Heartbeats__Provider=Ping in compose.yaml) stands in for elmah.io.
ELMAHIO_API_KEY=
ELMAHIO_LOG_ID=
ELMAHIO_HEARTBEAT_WAL=http://heartbeats/wal
ELMAHIO_HEARTBEAT_BACKUP=http://heartbeats/backup
ELMAHIO_HEARTBEAT_VERIFY=http://heartbeats/verify
ELMAHIO_HEARTBEAT_DRILL=http://heartbeats/drill
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=rehearsal-grafana
GRAFANA_SMTP_FROM=no-reply@kupro.local
# Grafana refuses to start without a contact address; nothing is sent (no SMTP).
ALERT_EMAIL=alerts@kupro.local
