    "@fontsource/fragment-mono": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.11",
    "lucide-react": "^1.64.0",
