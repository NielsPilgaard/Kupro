    "@fontsource/fragment-mono": "^5.3.0",
    "@microsoft/signalr": "^11.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "cmdk": "^1.1.1",
    "i18next": "^27.1.1",
    "lucide-react": "^1.73.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
