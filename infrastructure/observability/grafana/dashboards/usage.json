    {
      "type": "timeseries",
      "id": 10,
      "title": "Slowest request per area",
      "description": "Single slowest request per area and bucket. Cold starts sit on the purple deploy markers; the Service health dashboard splits cold from warm and links slow requests to traces.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "max_over_time({service_namespace=\"kupro\", service_name=\"api\"} | scope_name=\"Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware\" | Route!=\"\" | Route!=\"(unmatched)\" | Caller!=\"anonymous\" | label_format area=`{{ regexReplaceAll \"[/{].*\" (trimPrefix \"workspaces/{workspace}/\" (trimPrefix \"/\" (trimPrefix \"/api/v1\" .Route))) \"\" }}` | unwrap Duration [$__interval]) by (area)",
          "legendFormat": "{{area}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "pointSize": 6,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
