{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "kupro-api",
      "folder": "Kupro",
      "interval": "1m",
      "rules": [
        {
          "uid": "kupro-api-down",
          "title": "Kupro API down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"kupro/api\", http_route=~\"/alive|/health\"}[5m]))",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.001
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Kupro API has not answered a health probe for 5 minutes.",
            "description": "No /alive (or local /health) requests recorded. The container is down or crash-looping, a migration failed (the API waits for it), or telemetry stopped reaching Prometheus (alloy). Check Dokploy and 'Startups, shutdowns and migrations'.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "2"
          }
        },
        {
          "uid": "kupro-errors-logged",
          "title": "Kupro errors logged",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({service_namespace=\"kupro\"} | severity_number >= 17 [10m]))",
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "replaceNN",
                  "replaceWithValue": 0
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Kupro logged {{ $values.B.Value }} error line(s) in the last 10 minutes.",
            "description": "Covers 500 responses, failed migrations and background work. See 'Distinct errors' on the Errors & logs dashboard for message, stack trace and TraceId.",
            "__dashboardUid__": "kupro-errors",
            "__panelId__": "4"
          }
        },
        {
          "uid": "kupro-restart-loop",
          "title": "Kupro API restart loop",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(count_over_time({service_namespace=\"kupro\", service_name=\"api\"} | scope_name=\"Microsoft.Hosting.Lifetime\" |= \"Application started\" [15m]))",
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "replaceNN",
                  "replaceWithValue": 0
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Kupro API started {{ $values.B.Value }} times in 15 minutes.",
            "description": "Three or more 'Application started' lines in 15 minutes: the container is crash-looping (missing config, OOM, Keycloak unreachable). A normal deploy starts once.",
            "__dashboardUid__": "kupro-errors",
            "__panelId__": "8"
          }
        },
        {
          "uid": "kupro-latency-budget",
          "title": "Kupro latency budget breached",
          "condition": "D",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "quantile_over_time(0.99, {service_namespace=\"kupro\", service_name=\"api\"} | scope_name=\"Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware\" | Route!=\"\" | Route!=\"(unmatched)\" | RequestId!~\".*:00000001\" | unwrap Duration [1h]) by (service_name)",
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "replaceNN",
                  "replaceWithValue": 0
                }
              }
            },
            {
              "refId": "E",
              "datasourceUid": "loki",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "E",
                "expr": "sum by (service_name) (count_over_time({service_namespace=\"kupro\", service_name=\"api\"} | scope_name=\"Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware\" | Route!=\"\" | Route!=\"(unmatched)\" | RequestId!~\".*:00000001\" [1h]))",
                "queryType": "instant",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "F",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "F",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "E",
                "reducer": "last",
                "settings": {
                  "mode": "replaceNN",
                  "replaceWithValue": 0
                }
              }
            },
            {
              "refId": "D",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "D",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "math",
                "expression": "$B > 500 && $F >= 100"
              }
            }
          ],
          "for": "15m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Kupro warm p99 is {{ printf \"%.0f\" $values.B.Value }} ms over the last hour (budget 500 ms).",
            "description": "ADR-010: every endpoint < 500 ms p99. Warm requests only (reused connections), so a deploy's cold-start burst can't trigger it; needs 100+ requests in the hour. Open 'Endpoints' and 'Requests over budget' on the Service health dashboard for the route and the trace.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "17"
          }
        },
        {
          "uid": "kupro-disk-full",
          "title": "Kupro disk almost full",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max(1 - node_filesystem_avail_bytes{job=\"integrations/unix\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"integrations/unix\", mountpoint=\"/\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Docker's data disk on the VPS is {{ humanizePercentage $values.B.Value }} full.",
            "description": "Postgres stops accepting writes when the disk fills. Prune old images (`docker image prune -a`), check the telemetry volumes, or grow the disk.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "27"
          }
        },
        {
          "uid": "kupro-postgres-down",
          "title": "Kupro Postgres down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max(pg_up{job=\"integrations/postgres\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "2m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Postgres is not answering.",
            "description": "Alloy's Postgres exporter can't connect. The API fails every request that touches the database. Check the postgres container in Dokploy. No data = Alloy itself is down; 'Kupro API down' fires too then.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "28"
          }
        },
        {
          "uid": "kupro-keycloak-down",
          "title": "Kupro Keycloak down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max(up{job=\"keycloak\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Keycloak has not answered a metrics scrape for 5 minutes.",
            "description": "Nobody can sign in, and the API can't fetch signing keys after a restart. Check the keycloak container in Dokploy and its logs.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "29"
          }
        },
        {
          "uid": "kupro-backups-unhealthy",
          "title": "Kupro backups unhealthy",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max(backup_agent_health{job=\"kupro/backup-agent\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "replaceNN",
                  "replaceWithValue": 0
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1.5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "The backup agent reports Unhealthy.",
            "description": "Data may not be reaching the backup repo (WAL gap, S3 down, no full backup in 26 h, failed drill or verify). Open the backup console (restore runbook §1); its Overview lists the issues. Missing data is 'Kupro backup agent silent'.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "36"
          }
        },
        {
          "uid": "kupro-backup-agent-silent",
          "title": "Kupro backup agent silent",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max(backup_agent_status_age_seconds{job=\"kupro/backup-agent\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        900
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "labels": {
            "service": "kupro",
            "severity": "critical"
          },
          "annotations": {
            "summary": "The backup agent has not reported a status for over 15 minutes.",
            "description": "The backup-agent container is down, stuck, or can't reach Alloy. Postgres keeps running, but nothing new is backed up: WAL piles up in Postgres until the replication slot is dropped (4 GB). Check the container (`docker ps -a | grep backup-agent`, `docker logs`) and redeploy.",
            "__dashboardUid__": "kupro-health",
            "__panelId__": "37"
          }
        }
      ]
    }
  ]
}
