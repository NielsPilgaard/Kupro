// Grafana Alloy, the one collector (ADR-014). Two jobs:
//   1. OTLP from the apps → Loki (logs), Tempo (traces), Prometheus (metrics). The fan-out is in export.alloy.
//   2. Scrape what doesn't speak OTLP — the host, Postgres, Keycloak — and remote-write it to Prometheus.
// Every URL comes from the AppHost as an environment variable, so the same files work under `aspire run` and in
// the published compose. Alloy loads every .alloy file in /etc/alloy/flowstate as one config.

logging {
	level = "warn"
}

// ------------------------------------------------------------------ OTLP from the apps

otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		logs    = [otelcol.processor.memory_limiter.apps.input]
		metrics = [otelcol.processor.memory_limiter.apps.input]
		traces  = [otelcol.processor.memory_limiter.apps.input]
	}
}

// Drop data rather than grow past the container's memory limit when a backend is slow or down.
otelcol.processor.memory_limiter "apps" {
	check_interval = "1s"
	limit          = "300MiB"
	spike_limit    = "75MiB"

	output {
		logs    = [otelcol.processor.batch.apps.input]
		metrics = [otelcol.processor.batch.apps.input]
		traces  = [otelcol.processor.batch.apps.input]
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = sys.env("LOKI_URL") + "/otlp"
	}
}

otelcol.exporter.otlphttp "prometheus" {
	client {
		endpoint = sys.env("PROMETHEUS_URL") + "/api/v1/otlp"
	}
}

otelcol.exporter.otlphttp "tempo" {
	client {
		endpoint = sys.env("TEMPO_OTLP_URL")
	}
}

// ------------------------------------------------------------------ Scraped metrics

prometheus.remote_write "prometheus" {
	endpoint {
		url = sys.env("PROMETHEUS_URL") + "/api/v1/write"
	}
}

// Host: no host mounts. /proc/stat, /proc/meminfo and /proc/loadavg aren't namespaced, so a container reads the
// host's CPU, memory and load. Disk = the filesystem behind the container's root, which is Docker's data disk —
// the one the volumes live on. Under Docker Desktop "host" is its VM.
prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "meminfo", "loadavg", "filesystem"]
	// Only "/"; the default excludes overlay, which is exactly the root we want.
	filesystem {
		fs_types_exclude     = "^(tmpfs|proc|sysfs|devpts|mqueue|cgroup2?|nsfs)$"
		mount_points_exclude = "^/.+"
	}
}

prometheus.scrape "host" {
	// job="integrations/unix", set by the exporter.
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// Superuser, as the AppHost knows no other. The password is URL-encoded here, so it may contain anything.
prometheus.exporter.postgres "flowstate" {
	data_source_names = [string.format(
		"postgresql://%s:%s@%s/postgres?sslmode=disable",
		sys.env("POSTGRES_USER"),
		encoding.url_encode(sys.env("POSTGRES_PASSWORD")),
		sys.env("POSTGRES_ADDRESS"),
	)]
}

prometheus.scrape "postgres" {
	// job="integrations/postgres", set by the exporter.
	targets         = prometheus.exporter.postgres.flowstate.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// Keycloak's management port (KC_METRICS_ENABLED). Under `aspire run` it serves Aspire's dev certificate.
prometheus.scrape "keycloak" {
	targets = [{
		"__address__" = sys.env("KEYCLOAK_MANAGEMENT_ADDRESS"),
		"__scheme__"  = sys.env("KEYCLOAK_MANAGEMENT_SCHEME"),
		"job"         = "keycloak",
	}]
	job_name        = "keycloak"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.prometheus.receiver]

	tls_config {
		insecure_skip_verify = true
	}
}
