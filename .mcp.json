{
  "mcpServers": {
    "grafana-kupro": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana:2.0.2",
        "-t", "stdio",
        "--disable-write"
      ],
      "env": {
        "GRAFANA_URL": "${KUPRO_GRAFANA_URL:-https://grafana.kupro.dk}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${KUPRO_GRAFANA_TOKEN:-}"
      }
    },
    "grafana-cloud": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana:2.0.2",
        "-t", "stdio",
        "--disable-write"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_CLOUD_URL:-}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_CLOUD_TOKEN:-}"
      }
    }
  }
}
